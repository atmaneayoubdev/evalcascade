# EvalCascade environment template.
#
#   cp .env.example .env      # then edit .env (it is git-ignored; never commit it)
#
# EvalCascade loads .env from the current directory (or the nearest parent directory that
# has one) without overriding variables that are already set. Set
# EVALCASCADE_DISABLE_DOTENV=1 to turn that off. Every value below is a placeholder.

# --- Required for Jev (System One) and the default OpenRouter LLM judge -------------------
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- Optional: use a different OpenAI-compatible endpoint as the LLM judge ----------------
# Setting EVALCASCADE_JUDGE_BASE_URL on its own switches the judge provider to
# "openai_compatible". That provider needs its own key and never receives
# OPENROUTER_API_KEY. For a server without authentication set
# EVALCASCADE_JUDGE_REQUIRE_API_KEY=false instead of a key.
# EVALCASCADE_JUDGE_PROVIDER=openai_compatible
# EVALCASCADE_JUDGE_BASE_URL=https://llm.example.com/v1
# EVALCASCADE_JUDGE_API_KEY=your-judge-api-key-here
# EVALCASCADE_JUDGE_MODEL=your-judge-model-id
# EVALCASCADE_JUDGE_REQUIRE_API_KEY=true
# Extra request fields as JSON, e.g. to disable "thinking" on Qwen-style servers:
# EVALCASCADE_JUDGE_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# Per-million-token prices, used to estimate cost when the endpoint reports none:
# EVALCASCADE_JUDGE_INPUT_COST_PER_MTOK=0.40
# EVALCASCADE_JUDGE_OUTPUT_COST_PER_MTOK=1.60

# --- Optional: protect the local API when it listens on anything other than 127.0.0.1 ----
# Clients must then send "Authorization: Bearer <token>".
# EVALCASCADE_API_TOKEN=replace-with-a-long-random-string

# --- Optional: routing policy -------------------------------------------------------------
# EVALCASCADE_PRIMARY=jev
# EVALCASCADE_FALLBACK=llm
# EVALCASCADE_ESCALATE_BELOW=0.82

# --- Optional: storage --------------------------------------------------------------------
# EVALCASCADE_HOME=.evalcascade
# EVALCASCADE_DATABASE_URL=sqlite:///absolute/path/to/evalcascade.db
